@model Neo_Genesis_Green_Gold.ViewModels.SolicitudVacacionesViewModel

@{
    ViewBag.Title = "Create";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row">
    <div class="ibox-content col-sm-12 marginTop5">
        <button class="btn btn-success" id="back-to-main" onclick="window.history.back();">
            <i class="fa fa-arrow-left"></i>
        </button>
        <span class="menu-title">RECURSOS HUMANOS / SOLICITUD DE VACACIONES / NUEVA SOLICITUD</span>
    </div>
</div>

<div class="row">
    <div class="ibox-content col-sm-12 margintop1">
        @using (Html.BeginForm("Create", "Solicitud_Vacaciones", FormMethod.Post))
        {
            @Html.HiddenFor(model => model.Vacacion.id_vacacion)
            @Html.HiddenFor(model => model.Vacacion.folio_registro)

            <div class="form-group row">
                <label class="col-sm-1 col-form-label">FOLIO</label>
                <div class="col-sm-1">
                    <input type="text" class="form-control" value="@Model.Vacacion.folio_registro" disabled />
                </div>
            </div>

            <div class="form-group row text-center">
                <label class="col-sm-12 col-form-label">Fotografía del Trabajador</label>
                <div class="col-sm-12">
                    <img id="imgEmpleado" src="~/Content/IMG/Default/user.png" alt="Fotografía del Trabajador" class="imgEmpleado img-fluid img-circle" />
                </div>
            </div>

            <div class="form-group row">
                <label class="col-sm-2 col-form-label">UBICACION</label>
                <div class="col-sm-2">
                    <select class="form-control" id="ubicacionSelect" name="Vacacion.id_ubicacion" onchange="cargarEmpleadosPorUbicacion(this.value)">
                        <option value="">Seleccionar Ubicación</option>
                        @foreach (var ubicacion in Model.List_Ubicaciones)
                        {
                            <option value="@ubicacion.IdUbicacion" @(ubicacion.IdUbicacion == Model.Vacacion.id_ubicacion ? "selected" : "")>
                                @ubicacion.Nombre
                            </option>
                        }
                    </select>
                </div>

                <label class="col-sm-2 col-form-label">EMPLEADO</label>
                <div class="col-sm-2">
                    <select class="form-control" id="empleadoSelect" name="Vacacion.id_empleado" onchange="loadDiasDisponibles(this.value)">
                        <option value="">Seleccionar Empleado</option>
                        @foreach (var empleado in Model.List_Empleados)
                        {
                            <option value="@empleado.IdEmpleado" data-img="@empleado.Img_empleado_nombre"
                                    @(empleado.IdEmpleado == Model.Vacacion.id_empleado ? "selected" : "")>
                                @empleado.Nombre @empleado.ApellidoPaterno
                            </option>
                        }
                    </select>
                </div>

                <label class="col-sm-2 col-form-label">Días Disponibles</label>
                <div class="col-sm-2">
                    <input type="text" id="diasDisponibles" class="form-control" value="@Model.DiasDisponibles" disabled />
                </div>
            </div>

            <div class="form-group row">
                <label class="col-sm-2 col-form-label">INICIO DE VACACIONES</label>
                <div class="col-sm-4">
                    @Html.TextBoxFor(model => model.Vacacion.fecha_inicio, new { @class = "form-control", type = "date", id = "inicioVacaciones", disabled = "disabled", onchange = "calcularVacaciones()" })
                </div>

                <label class="col-sm-2 col-form-label">TERMINO DE VACACIONES</label>
                <div class="col-sm-4">
                    @Html.TextBoxFor(model => model.Vacacion.fecha_fin, new { @class = "form-control", type = "date", id = "terminoVacaciones", disabled = "disabled", onchange = "calcularVacaciones()" })
                </div>
            </div>

            <div class="form-group row">
                <label class="col-sm-2 col-form-label">Días a Tomar</label>
                <div class="col-sm-2">
                    <input type="text" id="diasATomar" class="form-control" value="0" disabled />
                    @Html.HiddenFor(model => model.Vacacion.dias_vacacion, new { id = "diasATomarHidden" })
                </div>

                <label class="col-sm-2 col-form-label">Fecha de Incorporación</label>
                <div class="col-sm-2">
                    <input type="date" id="fechaIncorporacion" class="form-control" disabled />
                    @Html.HiddenFor(model => model.Vacacion.fecha_incorporacion, new { id = "fechaIncorporacionHidden" })
                </div>

                <label class="col-sm-2 col-form-label">Días Restantes</label>
                <div class="col-sm-2">
                    <input type="text" id="diasRestantes" class="form-control" value="@Model.DiasRestantes" disabled />
                    @Html.HiddenFor(model => model.Vacacion.dias_restantes, new { id = "diasRestantesHidden" })
                </div>
            </div>

            <div class="form-group row">
                <label class="col-sm-12 col-form-label">Observaciones</label>
                <div class="col-sm-12">
                    @Html.TextAreaFor(model => model.Vacacion.observaciones, new { @class = "form-control", rows = 3 })
                </div>
            </div>

            <div class="form-group row text-center">
                <button type="submit" class="btn btn-success">Guardar Solicitud</button>
            </div>
        }
    </div>
</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

<script>
    $(document).ready(function () {
        $('#inicioVacaciones').prop('disabled', true);
        $('#terminoVacaciones').prop('disabled', true);
        $("#empleadoSelect").select2();
    });

    function loadDiasDisponibles(idEmpleado) {
    if (!idEmpleado) {
        $('#diasDisponibles').val(0);
        $('#inicioVacaciones').prop('disabled', true);
        $('#terminoVacaciones').prop('disabled', true);
        return;
    }

    $.ajax({
        url: '@Url.Action("GetDiasDisponibles", "Solicitud_Vacaciones")',
        type: 'GET',
        data: { idEmpleado: idEmpleado },
        success: function (data) {
            console.log("Respuesta del servidor:", data); // Para depuración
            if (data.error) {
                alert("Error: " + data.error);
                $('#diasDisponibles').val(0);
                $('#inicioVacaciones').prop('disabled', true);
                $('#terminoVacaciones').prop('disabled', true);
            } else {
                $('#diasDisponibles').val(data.diasDisponibles);

                if (data.diasDisponibles > 0) {
                    $('#inicioVacaciones').prop('disabled', false);
                    $('#terminoVacaciones').prop('disabled', false);
                } else {
                    $('#inicioVacaciones').prop('disabled', true);
                    $('#terminoVacaciones').prop('disabled', true);
                }
            }
        },
        error: function (xhr, status, error) {
            console.error("Error al cargar días disponibles:", error);
            alert('Ocurrió un error al cargar los días disponibles.');
        }
    });
}


   function calcularVacaciones() {
    var inicio = $('#inicioVacaciones').val();
    var termino = $('#terminoVacaciones').val();
    var diasDisponibles = parseInt($('#diasDisponibles').val());

    if (!inicio || !termino) {
        alert("Por favor selecciona las fechas de inicio y término de vacaciones.");
        return;
    }

    $.ajax({
        url: '@Url.Action("CalcularDiasInhabiles", "Solicitud_Vacaciones")',
        type: 'GET',
        data: { inicio: inicio, termino: termino },
        success: function (data) {
            console.log("Respuesta del servidor:", data);

            if (data.error) {
                alert("Error: " + data.error);
            } else {
                // Actualizar campos con la respuesta del servidor
                $('#diasATomar').val(data.diasTotales - data.diasInhabiles);
                $('#diasATomarHidden').val(data.diasTotales - data.diasInhabiles);

                $('#diasRestantes').val(diasDisponibles - (data.diasTotales - data.diasInhabiles));
                $('#diasRestantesHidden').val(diasDisponibles - (data.diasTotales - data.diasInhabiles));

                $('#fechaIncorporacion').val(data.fechaIncorporacion);
                $('#fechaIncorporacionHidden').val(data.fechaIncorporacion);
            }
        },
        error: function (xhr, status, error) {
            console.error("Error en la solicitud:", error);
            alert("Ocurrió un error al intentar calcular los días.");
        }
    });
}



    function cargarEmpleadosPorUbicacion(idUbicacion) {
    if (!idUbicacion) {
        $('#empleadoSelect').empty().append('<option value="">Seleccionar Empleado</option>');
        $('#imgEmpleado').attr('src', '/Content/IMG/Default/user.png');
        return;
    }

    $.ajax({
        url: '@Url.Action("GetEmpleadosByUbicacion", "Solicitud_Vacaciones")',
        type: 'GET',
        data: { idUbicacion: idUbicacion },
        success: function (response) {
            if (response.success) {
                var empleados = response.empleados;
                var empleadoSelect = $('#empleadoSelect');
                empleadoSelect.empty().append('<option value="">Seleccionar Empleado</option>');

                empleados.forEach(function (empleado) {
                    empleadoSelect.append('<option value="' + empleado.IdEmpleado + '" data-img="' + empleado.ImgEmpleado + '">' +
                        empleado.Nombre + '</option>');
                });

                $('#imgEmpleado').attr('src', '/Content/IMG/Default/user.png'); // Restablecer la imagen
            } else {
                alert('Error al cargar empleados: ' + response.message);
            }
        },
        error: function (xhr, status, error) {
            console.error("Error al cargar empleados:", error);
            alert('Ocurrió un error al cargar los empleados.');
        }
    });
}

</script>
