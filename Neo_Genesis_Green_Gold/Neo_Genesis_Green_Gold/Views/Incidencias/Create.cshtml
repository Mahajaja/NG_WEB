@model Neo_Genesis_Green_Gold.ViewModels.IncidenciasViewModel
@{
    ViewBag.Title = "Create";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row">
    <div class="ibox-content col-sm-12 marginTop5">
        <button class="btn btn-success" id="back-to-main" onclick="window.history.back();">
            <i class="fa fa-arrow-left"></i>
        </button>
        <span class="menu-title">RECURSOS HUMANOS / SOLICITUD DE VACACIONES / INCIDENCIAS</span>
    </div>
</div>


<div class="row">
    <div class="ibox-content col-sm-12 margintop1">
        @using (Html.BeginForm("Create", "Incidencias", FormMethod.Post))
        {
            <div class="form-group row">
                <label class="col-sm-1 col-form-label">FOLIO</label>
                <div class="col-sm-1">
                    <input type="text" class="form-control" value="@Model.IncidenciaModel.folio_incidencia" disabled />
                    <input type="hidden" value="@Model.IncidenciaModel.id_incidencia" name="id_incidencia" id="id_incidencia"/>
                </div>
            </div>

            <div class="form-group row text-center">
                <label class="col-sm-12 col-form-label">Fotografía del Trabajador</label>
                <div class="col-sm-12">
                    <img id="imgEmpleado" src="~/Content/IMG/Default/user.png" alt="Fotografía del Trabajador" class="imgEmpleado img-fluid img-circle" />
                </div>
            </div>

            <div class="form-group row">
                <hr />
            </div>

            <div class="form-group row">
                <!-- Selector de EMPLEADO -->
                <label class="col-sm-2 col-form-label">EMPLEADO</label>
                <div class="col-sm-4">
                    <select class="form-control" id="empleadoSelect" name="IdEmpleado" onchange="loadDiasDisponibles(this.value)">
                        <option value="">Seleccionar Empleado</option>
                        @foreach (var empleado in Model.List_Empleados)
                        {
                            <option value="@empleado.IdEmpleado" data-img="@empleado.Img_empleado_nombre">
                                @empleado.Nombre @empleado.ApellidoPaterno
                            </option>
                        }
                    </select>
                </div>

                <!-- Texto TIPO REGISTRO y Radio Buttons -->
                <label class="col-sm-2 col-form-label">TIPO REGISTRO</label>
                <div class="col-sm-4">
                    <div class="form-check form-check-inline">
                        <input class="form-check-input" type="radio" name="tipoRegistro" id="permiso" value="Permiso" onclick="toggleFields()">
                        <label class="form-check-label" for="permiso">Permiso</label>
                    </div>
                    <div class="form-check form-check-inline">
                        <input class="form-check-input" type="radio" name="tipoRegistro" id="incidencia" value="Incidencia" onclick="toggleFields()">
                        <label class="form-check-label" for="incidencia">Incidencia</label>
                    </div>
                </div>
            </div>


            <div class="form-group row">

                <div id="permisoContainer" style="display: none;">
                    <div class="form-group row">
                        <label class="col-sm-2 col-form-label">TIPO DE PERMISO</label>
                        <div class="col-sm-4">
                            <select class="form-control" name="TipoSancion">
                                <option value="">Seleccionar Tipo de Permiso</option>
                                <option value="Solicitud de día de descanso">Solicitud de día de descanso</option>
                            </select>
                        </div>

                        <label class="col-sm-2 col-form-label">Tiempo</label>
                        <div class="col-sm-4">
                            <select class="form-control" name="Sancion">
                                <option value="">Seleccionar Tiempo</option>
                                <option value="Horas">Horas</option>
                                <option value="Medio Día">Medio Día</option>
                                <option value="Día completo">Día completo</option>
                            </select>
                        </div>
                    </div>
                </div>

                <!-- Contenedor para Tipo de Sanción y Consecuencia (visible solo si se selecciona "Incidencia") -->
                <div id="incidenciaContainer" style="display: none;">
                    <div class="form-group row">
                        <label class="col-sm-2 col-form-label">TIPO DE SANCION</label>
                        <div class="col-sm-4">
                            <select class="form-control" name="TipoSancion">
                                <option value="">Seleccionar Tipo de Sanción</option>
                                <option value="Llamada de atención">Llamada de atención</option>
                                <option value="Reporte">Reporte</option>
                                <option value="Acta Administrativa">Acta Administrativa</option>
                            </select>
                        </div>

                        <label class="col-sm-2 col-form-label">CONSECUENCIA</label>
                        <div class="col-sm-4">
                            <select class="form-control" name="Sancion">
                                <option value="">Seleccionar Consecuencia</option>
                                <option value="Ninguna">Ninguna</option>
                                <option value="Suspensión de Actividades">Suspensión de Actividades</option>
                                <option value="Baja Definitiva">Baja Definitiva</option>
                            </select>
                        </div>
                    </div>
                </div>


            </div>

            <div class="form-group row">
                <hr />
            </div>

            <div class="form-group row">
                <!-- ¿Se descontarán días? -->
                <label class="col-sm-2 col-form-label">¿Se descontarán días?</label>
                <div class="col-sm-2">
                    <div class="form-check form-check-inline">
                        <input class="form-check-input" type="radio" name="descontarDias" id="descontarSi" value="Si" checked>
                        <label class="form-check-label" for="descontarSi">Si</label>
                    </div>
                    <div class="form-check form-check-inline">
                        <input class="form-check-input" type="radio" name="descontarDias" id="descontarNo" value="No">
                        <label class="form-check-label" for="descontarNo">No</label>
                    </div>
                </div>

                <!-- ¿Cuántos días? -->
                <label class="col-sm-2 col-form-label">¿Cuántos días?</label>
                <div class="col-sm-2">
                    <input type="number" class="form-control" name="cuantosDias" placeholder="">
                </div>

                <!-- ¿Cuenta con goce de sueldo? -->
                <label class="col-sm-2 col-form-label">¿Cuenta con goce de sueldo?</label>
                <div class="col-sm-2">
                    <div class="form-check form-check-inline">
                        <input class="form-check-input" type="radio" name="goceSueldo" id="goceSi" value="Si">
                        <label class="form-check-label" for="goceSi">Si</label>
                    </div>
                    <div class="form-check form-check-inline">
                        <input class="form-check-input" type="radio" name="goceSueldo" id="goceNo" value="No" checked>
                        <label class="form-check-label" for="goceNo">No</label>
                    </div>
                </div>
            </div>

            <div class="form-group row">
                <!-- Descripción de la incidencia -->
                <label class="col-sm-2 col-form-label">DESCRIPCION INCIDENCIA</label>
                <div class="col-sm-10">
                    <textarea class="form-control" name="descripcionIncidencia" rows="3"></textarea>
                </div>
            </div>



            <div class="form-group row">
                <label class="col-sm-2 col-form-label">FECHA INICIO</label>
                <div class="col-sm-4">
                    <input type="date" class="form-control" id="inicioVacaciones" name="FechaInicio" onchange="calcularVacaciones()" />
                </div>
                <label class="col-sm-2 col-form-label">FECHA TERMINO</label>
                <div class="col-sm-4">
                    <input type="date" class="form-control" id="inicioVacaciones" name="FechaInicio" onchange="calcularVacaciones()" />
                </div>
            </div>

            <div class="form-group row">
                <hr />
            </div>
            <div class="form-group row text-center">
                <button type="submit" class="btn btn-success">Guardar Solicitud</button>
            </div>
        }
    </div>
</div>


<script>


    $(document).ready(function () {
        $("#empleadoSelect").select2();
        $("#tipoSancionSelect").select2();
        $("#sancionSelect").select2();

        $('select').select2({
            language: {

                noResults: function () {

                    return "No hay resultados";
                },
                searching: function () {

                    return "Buscando..";
                }
            }
        });
    });

    function loadDiasDisponibles(idEmpleado) {
        var selectedOption = $('#empleadoSelect option:selected');
        var imgEmpleado = '/Content/IMG_Empleados/' + selectedOption.data('img');

        if (selectedOption.data('img')) {
            $('#imgEmpleado').attr('src', imgEmpleado);
        } else {
            $('#imgEmpleado').attr('src', '/Content/IMG/Default/user.png');
        }
    }

    function toggleFields() {
        // Obtener los radio buttons
        var permisoRadio = document.getElementById("permiso");
        var incidenciaRadio = document.getElementById("incidencia");

        // Obtener los contenedores
        var permisoContainer = document.getElementById("permisoContainer");
        var incidenciaContainer = document.getElementById("incidenciaContainer");

        // Mostrar el contenedor correspondiente según el radio button seleccionado
        if (permisoRadio.checked) {
            permisoContainer.style.display = "block";
            incidenciaContainer.style.display = "none";
        } else if (incidenciaRadio.checked) {
            permisoContainer.style.display = "none";
            incidenciaContainer.style.display = "block";
        } else {
            permisoContainer.style.display = "none";
            incidenciaContainer.style.display = "none";
        }
    }

</script>