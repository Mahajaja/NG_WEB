@model Neo_Genesis_Green_Gold.ViewModels.OrdenMantenimientoViewModel
@{
    ViewBag.Title = "OrdenMantenimiento";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row">
    <div class="ibox-content col-sm-12 margintop1">
        <a class="btn btn-success" id="back-to-main"  href="@Url.Action("ConfirmDelete","Solicitud_Mantenimiento", new {id = Model.OrdenMantenimiento.IdOrden})">
            <i class="fa fa-arrow-left"></i>
        </a>
        <span class="menu-title">MANTENIMIENTO / SOLICITUD DE MANTENIMIENTO / ORDEN DE MANTENIMIENTO</span>
    </div>
</div>


<div class="row colsm margintop1">
    <div class="ibox-content col-sm-12 ">
        <div class="form-group row">
            <label class="col-sm-2 col-form-label">FOLIO DE SOLICITUD DE MANTENIMIENTO</label>
            <div class="col-sm-2">
                <input type="text" class="form-control" value="@Model.SolicitudMantenimiento.FolioSolicitud" disabled />
                <input type="hidden" value="" name="IdSolicitud" id="IdSolicitud" />
            </div>
            <label class="col-sm-2 col-form-label col-lg-offset-4">FOLIO DE ORDEN DE MANTENIMIENTO</label>
            <div class="col-sm-2">
                <input type="text" class="form-control" value="@Model.OrdenMantenimiento.FolioOrden" disabled />
                <input type="hidden" value="" name="IdSolicitud" id="IdSolicitud" />
            </div>
        </div>
    </div>
</div>

<div class="row colsm">
    <div class="col-sm-8 ">
        <div class="ibox-content col-sm-12 margintop1">

            @*AQUI VA EL USING*@


            <!-- Información General -->
            <div class="form-group row">
                <h3 class="col-sm-12">INFORMACION GENERAL</h3>
                <br />
                <div class="col-sm-6">
                    <label>UBICACION</label>
                    <input class="form-control" readonly value="@Model.SolicitudMantenimiento.NombreUbicacion"/>
                </div>

                <div class="col-sm-6">
                    <label>¿QUIEN REPORTA?</label>
                    <input class="form-control" readonly value="@Model.SolicitudMantenimiento.NombreEmpleado @Model.SolicitudMantenimiento.ApellidoEmpleado"/>
                </div>
            </div>

            <hr />

            <!-- Información del Servicio -->
            <div class="form-group row">
                <h3 class="col-sm-12">INFORMACION DEL SERVICIO</h3>
                <br />

                <div class="col-sm-3">
                    <label>EQUIPO</label>
                    <input class="form-control" readonly value="@Model.SolicitudMantenimiento.CategoriaNombre"/>
                </div>

                <!-- Grupo 1: Elementos que deben desaparecer si el ID seleccionado es 29 -->
                <div id="Group1">
                    <div class="col-sm-3">
                        <label>No. ECONOMICO</label>
                        <input class="form-control" readonly value="@Model.SolicitudMantenimiento.no_economico"/>
                    </div>

                    <div class="col-sm-3">
                        <label>MAQUINARIA</label>
                        <input class="form-control" readonly value="@Model.SolicitudMantenimiento.NombreMaquinaria" />
                    </div>

                    <div class="col-sm-3">
                        <label>ASIGNADO A:</label>
                        <input  class="form-control" readonly value="" />
                    </div>
                </div>

            </div>

            <div class="form-group row">
                <div class="col-sm-3">
                    <label>FECHA DE SERVICIO</label>
                    <input class="form-control" readonly value="@Model.SolicitudMantenimiento.FechaServicio"  />
                </div>
                <div class="col-sm-3">
                    <label>FECHA DE ENTREGA</label>
                    <input class="form-control" readonly value="@Model.SolicitudMantenimiento.FechaEntrega"  />
                </div>
                <div class="col-sm-3">
                    <label>GRADO DE URGENCIA</label>
                    <input class="form-control" readonly value="@Model.SolicitudMantenimiento.GradoUrgencia"  />
                </div>
                <div class="col-sm-3">
                    <label>RESPONSABLE SEGUIMIENTO</label>
                    <input class="form-control" readonly value="@Model.SolicitudMantenimiento.NombreResponsable @Model.SolicitudMantenimiento.ApellidoResponsable"  />
                </div>
            </div>

            <hr />



        </div>

        <div class="ibox-content col-sm-12 ">

            <div class="form-group row">

                <h3 class="col-sm-12">TIPO DE SERVICIO</h3>
                <br />
                <div class="col-sm-6">
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="TipoServicio" id="servicioInterno" value="Servicio Interno" checked>
                        <label class="form-check-label" for="servicioInterno">Servicio Interno</label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="TipoServicio" id="servicioExterno" value="Servicio Externo">
                        <label class="form-check-label" for="servicioExterno">Servicio Externo</label>
                    </div>
                </div>


                <!-- Contenedor para Encargado del Servicio -->
                <div id="ServicioInterno" class="col-sm-6">
                    <label>SERVICIO ATENTIDO POR:</label>
                    <input class="form-control" />
                </div>

            </div>
        </div>
    </div>
    <div class="col-sm-4">

        <div class="ibox-content col-sm-12 margintop1">
            <div class="form-group row">
                <h3 class="col-sm-12">EVIDENCIA DEL PROBLEMA REPORTADO</h3>
            </div>
            <br />
            <div class="form-group row">
                <!-- Evidencia 1 -->
                <div class="col-sm-6">
                    <div id="uploadBox1" style="border: 2px dashed #ccc; width: 100%; height: 200px; display: flex; justify-content: center; align-items: center; text-align: center;">
                        <span id="uploadText1">Clic para subir evidencia 1</span>
                        <img id="imagenPreview1" src="#" alt="Vista previa de la imagen 1" style="max-width: 100%; max-height: 100%; display: none;">
                    </div>
                    <input type="file" id="imagenInput1" name="imagen1" accept="image/*" style="display: none;" onchange="validateFile(event, 1)">
                    <button type="button" class="btn btn-danger" id="borrarEvidenciaBtn1" onclick="deleteEvidence(1)" style="display:none;">Borrar Evidencia 1</button>
                </div>

                <!-- Evidencia 2 -->

                <div class="col-sm-6">
                    <div id="uploadBox2" style="border: 2px dashed #ccc; width: 100%; height: 200px; display: flex; justify-content: center; align-items: center; text-align: center;">
                        <span id="uploadText2">Clic para subir evidencia 2</span>
                        <img id="imagenPreview2" src="#" alt="Vista previa de la imagen 2" style="max-width: 100%; max-height: 100%; display: none;">
                    </div>
                    <input type="file" id="imagenInput2" name="imagen2" accept="image/*" style="display: none;" onchange="validateFile(event, 1)">
                    <button type="button" class="btn btn-danger" id="borrarEvidenciaBtn2" onclick="deleteEvidence(2)" style="display:none;">Borrar Evidencia 2</button>
                </div>
            </div>
            <div class="form-group row">
                <!-- Evidencia 3 -->

                <div class="col-sm-6">
                    <div id="uploadBox3" style="border: 2px dashed #ccc; width: 100%; height: 200px; display: flex; justify-content: center; align-items: center; text-align: center;">
                        <span id="uploadText3">Clic para subir evidencia 3</span>
                        <img id="imagenPreview3" src="#" alt="Vista previa de la imagen 3" style="max-width: 100%; max-height: 100%; display: none;">
                    </div>
                    <input type="file" id="imagenInput3" name="imagen3" accept="image/*" style="display: none;" onchange="validateFile(event, 1)">
                    <button type="button" class="btn btn-danger" id="borrarEvidenciaBtn3" onclick="deleteEvidence(3)" style="display:none;">Borrar Evidencia 3</button>
                </div>

                <!-- Evidencia 4 -->

                <div class="col-sm-6">
                    <div id="uploadBox4" style="border: 2px dashed #ccc; width: 100%; height: 200px; display: flex; justify-content: center; align-items: center; text-align: center;">
                        <span id="uploadText4">Clic para subir evidencia 4</span>
                        <img id="imagenPreview4" src="#" alt="Vista previa de la imagen 4" style="max-width: 100%; max-height: 100%; display: none;">
                    </div>
                    <input type="file" id="imagenInput4" name="imagen4" accept="image/*" style="display: none;" onchange="validateFile(event, 1)">
                    <button type="button" class="btn btn-danger" id="borrarEvidenciaBtn4" onclick="deleteEvidence(4)" style="display:none;">Borrar Evidencia 4</button>
                </div>

            </div>

            <input type="hidden" id="imagen1Base64" name="Evidencia1" />
            <input type="hidden" id="imagen2Base64" name="Evidencia2" />
            <input type="hidden" id="imagen3Base64" name="Evidencia3" />
            <input type="hidden" id="imagen4Base64" name="Evidencia4" />
       
            <br />
        </div>
    </div>



</div>




<div class="row colsm">
    <div class="col-sm-4">
        <div class="ibox-content col-sm-12 margintop1">
            <div class="form-group row">
                <h3 class="col-sm-12">FINALIZACION DEL SERVICIO</h3>

            </div>
            <div class="form-group row">
                <div class="col-sm-12">
                    <label>DESCRIPCION DE LA FALLA</label>

                    <textarea class="form-control" name="DescripcionProblema" rows="5" required></textarea>
                </div>
            </div>

            <div class="form-group row">
                <div class="col-sm-12">
                    <label>DIAGNOSTICO DE LA FALLA</label>

                    <textarea class="form-control" name="DescripcionProblema" rows="5" required></textarea>
                </div>
            </div>

            <div class="form-group row">
                <div class="col-sm-12">
                    <label>OBSERVACIONES</label>

                    <textarea class="form-control" name="DescripcionProblema" rows="4" required></textarea>
                </div>
            </div>
        </div>
    </div>

    <div class="col-sm-4 ">
        <div class="ibox-content col-sm-12 margintop1">
            <div class="form-group row">
                <h3 class="col-sm-12">REFACCIONES</h3>
            </div>
            <div class="form-group row">
                <div class="col-sm-12">
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="TipoServicio" id="servicioInterno" value="Si" checked>
                        <label class="form-check-label" for="servicioInterno">Si</label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="TipoServicio" id="servicioExterno" value="No">
                        <label class="form-check-label" for="servicioExterno">No</label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="incluidasServicio" id="incluidasServicio" value="Incluidas en el Servicio">
                        <label class="form-check-label" for="incluidasServicio">Incluidas en el Servicio</label>
                    </div>
                </div>
            </div>

            <div class="form-group row">

                <div class="col-sm-6">
                    <label>FOLIO SALIDA ALMACEN</label>
                    <input class="form-control" />
                </div>

                <div class="col-sm-6">
                    <label>FOLIO ORDEN DE COMPRA</label>
                    <input class="form-control" />
                </div>
            </div>
        </div>
        <div class="ibox-content col-sm-12 margintop1">
            <div class="form-group row">
                <h3 class="col-sm-12">TIEMPO INVERTIDO</h3>
            </div>
            <div class="form-group row">
                <div class="col-sm-12">
                    <label>¿FUE CORREGIDA LA FALLA?</label>
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="TipoServicio" id="servicioInterno" value="Si" checked>
                        <label class="form-check-label" for="servicioInterno">Si</label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="TipoServicio" id="servicioExterno" value="No">
                        <label class="form-check-label" for="servicioExterno">No</label>
                    </div>
                </div>
            </div>
            <div class="col-sm-6">
                <label>DIAS INVERTIDOS</label>
                <input class="form-control" />
            </div>
        </div>
    </div>

    <div class="col-sm-4">
        <div class="ibox-content col-sm-12 margintop1">
            <div class="form-group row">
                <h3 class="col-sm-12">EVIDENCIAS DE REPARACION</h3>
            </div>
            <div class="form-group row">
                <!-- Evidencia 1 -->
                <div class="col-sm-6">
                    <div id="uploadBox1" style="border: 2px dashed #ccc; width: 100%; height: 200px; display: flex; justify-content: center; align-items: center; text-align: center;">
                        <span id="uploadText1">Clic para subir evidencia 1</span>
                        <img id="imagenPreview1" src="#" alt="Vista previa de la imagen 1" style="max-width: 100%; max-height: 100%; display: none;">
                    </div>
                    <input type="file" id="imagenInput1" name="imagen1" accept="image/*" style="display: none;" onchange="validateFile(event, 1)">
                    <button type="button" class="btn btn-danger" id="borrarEvidenciaBtn1" onclick="deleteEvidence(1)" style="display:none;">Borrar Evidencia 1</button>
                </div>

                <!-- Evidencia 2 -->

                <div class="col-sm-6">
                    <div id="uploadBox2" style="border: 2px dashed #ccc; width: 100%; height: 200px; display: flex; justify-content: center; align-items: center; text-align: center;">
                        <span id="uploadText2">Clic para subir evidencia 2</span>
                        <img id="imagenPreview2" src="#" alt="Vista previa de la imagen 2" style="max-width: 100%; max-height: 100%; display: none;">
                    </div>
                    <input type="file" id="imagenInput2" name="imagen2" accept="image/*" style="display: none;" onchange="validateFile(event, 1)">
                    <button type="button" class="btn btn-danger" id="borrarEvidenciaBtn2" onclick="deleteEvidence(2)" style="display:none;">Borrar Evidencia 2</button>
                </div>
            </div>
            <div class="form-group row">
                <!-- Evidencia 3 -->

                <div class="col-sm-6">
                    <div id="uploadBox3" style="border: 2px dashed #ccc; width: 100%; height: 200px; display: flex; justify-content: center; align-items: center; text-align: center;">
                        <span id="uploadText3">Clic para subir evidencia 3</span>
                        <img id="imagenPreview3" src="#" alt="Vista previa de la imagen 3" style="max-width: 100%; max-height: 100%; display: none;">
                    </div>
                    <input type="file" id="imagenInput3" name="imagen3" accept="image/*" style="display: none;" onchange="validateFile(event, 1)">
                    <button type="button" class="btn btn-danger" id="borrarEvidenciaBtn3" onclick="deleteEvidence(3)" style="display:none;">Borrar Evidencia 3</button>
                </div>

                <!-- Evidencia 4 -->

                <div class="col-sm-6">
                    <div id="uploadBox4" style="border: 2px dashed #ccc; width: 100%; height: 200px; display: flex; justify-content: center; align-items: center; text-align: center;">
                        <span id="uploadText4">Clic para subir evidencia 4</span>
                        <img id="imagenPreview4" src="#" alt="Vista previa de la imagen 4" style="max-width: 100%; max-height: 100%; display: none;">
                    </div>
                    <input type="file" id="imagenInput4" name="imagen4" accept="image/*" style="display: none;" onchange="validateFile(event, 1)">
                    <button type="button" class="btn btn-danger" id="borrarEvidenciaBtn4" onclick="deleteEvidence(4)" style="display:none;">Borrar Evidencia 4</button>
                </div>

            </div>

            <input type="hidden" id="imagen1Base64" name="Evidencia1" />
            <input type="hidden" id="imagen2Base64" name="Evidencia2" />
            <input type="hidden" id="imagen3Base64" name="Evidencia3" />
            <input type="hidden" id="imagen4Base64" name="Evidencia4" />
            <br />
        </div>
    </div>
</div>
