@model Neo_Genesis_Green_Gold.ViewModels.Ubicaciones_x_Empleado_ViewModel

@{
    ViewBag.Title = "Ubicaciones del Empleado";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row">
    <div class="ibox-content col-sm-12 marginTop5">
        <a class="btn btn-success" id="back-to-main" href="@Url.Action("Empleados", "AdminUsers")">
            <i class="fa fa-arrow-left"></i>
        </a>
        <span class="menu-title">ADMIN EMPLEADOS / UBICACIONES</span>
    </div>
</div>

<div id="table-container" class="ibox-content col-sm-12">
    @using (Html.BeginForm("ActualizarUbicaciones", "AdminUsers", FormMethod.Post))
    {
        @Html.AntiForgeryToken()
        <input type="hidden" name="IdEmpleado" value="@Model.id_Empleado" />

        <table id="ubicaciones" class="table table-striped table-bordered">
            <thead>
                <tr>
                    <th><CENTER>#</CENTER></th>
                    <th>Nombre de la Ubicación</th>
                    <th>Asignar</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.ListUbicaciones != null && Model.ListUbicaciones.Count > 0)
                {
                    int index = 1;
                    foreach (var ubicacion in Model.ListUbicaciones)
                    {
                        <tr>
                            <td><center>@index</center></td>
                            <td>@ubicacion.Nombre</td>
                            <td>
                                <input type="checkbox"
                                       name="selectedUbicaciones"
                                       value="@ubicacion.IdUbicacion"
                                       @(Model.ListUbicacionesEmpleado.Any(e => e.Id_Ubicacion == ubicacion.IdUbicacion) ? "checked" : "") />
                            </td>
                        </tr>
                        index++;
                    }
                }
            </tbody>
        </table>

        <button type="submit" class="btn btn-success">Actualizar</button>
    }
</div>

<script src="~/Scripts/jquery.min.js"></script>
<script src="~/Scripts/jquery.dataTables.min.js"></script>
<script src="~/Scripts/dataTables.bootstrap.min.js"></script>

<script>
    $(document).ready(function () {
        $('#ubicaciones').DataTable({
            pageLength: 100,
            language: {
                "decimal": "",
                "emptyTable": "No hay información",
                "info": "Mostrando _START_ a _END_ de _TOTAL_ Entradas",
                "infoEmpty": "Mostrando 0 a 0 de 0 Entradas",
                "infoFiltered": "(Filtrado de _MAX_ entradas totales)",
                "infoPostFix": "",
                "thousands": ",",
                "lengthMenu": "Mostrar _MENU_ Entradas",
                "loadingRecords": "Cargando...",
                "processing": "Procesando...",
                "search": "Buscar:",
                "zeroRecords": "Sin resultados encontrados",
                "paginate": {
                    "first": "Primero",
                    "last": "Último",
                    "next": "Siguiente",
                    "previous": "Anterior"
                }
            }
        });
    });
</script>
