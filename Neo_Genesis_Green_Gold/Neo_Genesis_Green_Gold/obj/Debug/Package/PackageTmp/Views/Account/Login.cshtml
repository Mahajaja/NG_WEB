@using Neo_Genesis_Green_Gold.Models
@model LoginViewModel
@{
    ViewBag.Title = "Iniciar sesión";
    Layout = "~/Views/Shared/_Layout_Auth.cshtml";
}

<main aria-labelledby="title" class="container marginTop5">

    <div class="row ibox-content" style="background-color: #fcf8e37d !important; border: none !important; box-shadow: 0 9px 15px rgba(0, 0, 0, 0.5); ">

        <!-- Columna para la imagen -->
        <div class="col-md-6">
            <section id="imageSection" class="">
                <center>
                    <img src="/Content/IMG/Logos/GREEN GOLD.png" alt="Descripción de la imagen" class="img-fluid" style="width: 50%;">
                </center>
            </section>
        </div>

        <!-- Columna para el formulario de inicio de sesión -->
        <div class="col-md-6" style="padding:3%;">
            <section id="loginForm" class="">

                @using (Html.BeginForm("Login", "Account", new { ReturnUrl = ViewBag.ReturnUrl }, FormMethod.Post, new { role = "form" }))
                {
                    @Html.AntiForgeryToken()

                    @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                    <!-- Email Field -->
                    <div class="mb-3">
                        @Html.LabelFor(m => m.Email, new { @class = "form-label" })
                        @Html.TextBoxFor(m => m.Email, new { @class = "form-control blackInput", @style = "text-transform: uppercase;" })
                        @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger" })
                    </div>


                    <!-- Password Field -->
                    <div class="mb-3">
                        @Html.LabelFor(m => m.Password, new { @class = "form-label" })
                        <div class="input-group">
                            @Html.PasswordFor(m => m.Password, new { @class = "form-control blackInput", id = "passwordField" })
                            <button type="button" class="btn btn-outline-secondary toggle-password" id="togglePassword" style="cursor: pointer;">
                                <i id="toggleIcon" class="fa fa-eye"></i> <!-- Icono de FontAwesome -->
                            </button>
                        </div>

                        @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger" })
                    </div>


                    <!-- Remember Me Checkbox -->
                    <div class="mb-3 form-check">
                        @Html.CheckBoxFor(m => m.RememberMe, new { @class = "form-check-input" })
                        @Html.LabelFor(m => m.RememberMe, new { @class = "form-check-label" })
                    </div>

                    <!-- Submit Button -->
                    <div class="row">
                        <center>
                            @using (Html.BeginForm("LogOff", "Account", FormMethod.Post, new { role = "form" }))
                            {
                                <input type="submit" value="Iniciar sesión" class="btn btn-success w-100" />
                            }
                        </center>
                    </div>
                    <br />
                }
            </section>
        </div>

    </div>
</main>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <script>
        document.getElementById('togglePassword').addEventListener('click', function () {
            const passwordField = document.getElementById('passwordField');
            const toggleIcon = document.getElementById('toggleIcon');
            const type = passwordField.getAttribute('type') === 'password' ? 'text' : 'password';
            passwordField.setAttribute('type', type);

            // Cambia el ícono de FontAwesome
            toggleIcon.classList.toggle('fa-eye');
            toggleIcon.classList.toggle('fa-eye-slash');
        });
    </script>
}

