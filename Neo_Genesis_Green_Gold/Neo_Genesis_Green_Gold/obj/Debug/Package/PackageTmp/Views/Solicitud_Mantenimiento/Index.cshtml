@model List<Entity.SolicitudMtto_E>

@{
    ViewBag.Title = "Solicitudes de Mantenimiento";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row">
    <div class="ibox-content col-sm-12 margintop1">
        <a class="btn btn-success" id="back-to-main" href="@Url.Action("Index","Home")">
            <i class="fa fa-arrow-left"></i>
        </a>
        <span class="menu-title">MANTENIMIENTO / SOLICITUDES DE MANTENIMIENTO</span>
    </div>
</div>

<div class="col-sm-12 form-group margintop1">
    <a href="@Url.Action("CrearFolio", "Solicitud_Mantenimiento")" class="btn btn-success">Nueva Solicitud</a>
</div>

<div id="table-container" class="col-sm-12 ibox-content">
    <table id="solicitudesMtto" class="table table-striped table-bordered">
        <thead>
            <tr>
                <th><CENTER>#</CENTER></th>
                <th>FOLIO</th>
                <th>Fecha Aplic.</th>
                <th>Ubicación</th>
                <th>Quien reporta</th>
                <th># Economico / Instalación</th>
                <th>Prioridad</th>
                <th>COSTO</th>
                <th>TIPO SERVICIO</th>
                <th>FECHA ENTREGA</th>
                <th>ESTATUS</th>
                <th>OPC</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Count > 0)
            {
                int index = 1;
                foreach (var solicitud in Model)
                {
                    <tr>
                        <td><center>@index</center></td>
                        <td>@solicitud.FolioSolicitud</td>
                        <td>@solicitud.FechaRegistro</td>
                        <td>@solicitud.NombreUbicacion</td>
                        <td>@solicitud.NombreEmpleado @solicitud.ApellidoEmpleado</td>
                        @if (solicitud.IdCategoria == 29)
                        {
                            <td>@solicitud.nombre_referencia</td>
                        }
                        else
                        {
                            <td>@solicitud.no_economico</td>
                        }

                        <td>@solicitud.GradoUrgencia</td>
                        <td>@solicitud.CostoReparacion</td>
                        <td>@solicitud.TipoServicio</td>
                        <td>@solicitud.FechaEntrega</td>
                        <td>@solicitud.Estatus</td>
                        <td>
                            @if (solicitud.Estatus.Equals("En Proceso"))
                            {
                                <form method="get" action="@Url.Action("CrearFolio_Orden", "Solicitud_Mantenimiento")">
                                    <input type="hidden" name="id_Solicitud" value="@solicitud.IdSolicitud" />
                                    <button type="submit" class="btn btn-info btn-sm">
                                        <i class="fa fa-edit"></i> GENERAR ORDEN
                                    </button>
                                </form>
                            }
                            else
                            {
                                if (!solicitud.TieneEvaluacion)
                                {
                                    <form method="get" action="@Url.Action("CrearFolio_Eval_Mtto", "Solicitud_Mantenimiento")">
                                        <input type="hidden" name="id_Solicitud" value="@solicitud.IdSolicitud" />
                                        <button type="submit" class="btn btn-info btn-sm">
                                            <i class="fa fa-edit"></i> EVALUACION
                                        </button>
                                    </form>
                                }
    else
                        {
                            <h5>EVALUACION REALIZADA</h5>
                        }

                            }
                        </td>
                    </tr>
                    index++;
                }
            }
        </tbody>
    </table>
</div>

<script src="~/Scripts/jquery.dataTables.min.js"></script>
<script src="~/Scripts/dataTables.bootstrap.min.js"></script>
<script>
    $(document).ready(function () {
        $('#solicitudesMtto').DataTable({
            language: {
                "decimal": "",
                "emptyTable": "No hay información",
                "info": "Mostrando _START_ a _END_ de _TOTAL_ Entradas",
                "infoEmpty": "Mostrando 0 to 0 of 0 Entradas",
                "infoFiltered": "(Filtrado de _MAX_ total entradas)",
                "thousands": ",",
                "lengthMenu": "Mostrar _MENU_ Entradas",
                "loadingRecords": "Cargando...",
                "processing": "Procesando...",
                "search": "Buscar:",
                "zeroRecords": "Sin resultados encontrados",
                "paginate": {
                    "first": "Primero",
                    "last": "Último",
                    "next": "Siguiente",
                    "previous": "Anterior"
                }
            }
        });
    });
</script>
