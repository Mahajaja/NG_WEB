@model Neo_Genesis_Green_Gold.ViewModels.SolicitudMttoViewModel

@{
    ViewBag.Title = "Solicitud de Mantenimiento";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row">
    <div class="ibox-content col-sm-12 marginTop5">
        <a class="btn btn-success" id="back-to-main" href="@Url.Action("ConfirmDelete","Solicitud_Mantenimiento", new {id = Model.SolicitudMantenimientoMode.IdSolicitud})">
            <i class="fa fa-arrow-left"></i>
        </a>
        <span class="menu-title">MANTENIMIENTO / SOLICITUD DE MANTENIMIENTO / NUEVA SOLICITUD</span>
    </div>
</div>

<div class="row">
    <div class="ibox-content col-sm-12 margintop1">
        @using (Html.BeginForm("Create", "Solicitud_Mantenimiento", FormMethod.Post, new { enctype = "multipart/form-data" }))
        {
            <div class="form-group row">
                <label class="col-sm-1 col-form-label">FOLIO</label>
                <div class="col-sm-1">
                    <input type="text" class="form-control" value="@Model.SolicitudMantenimientoMode.FolioSolicitud" disabled />
                    <input type="hidden" value="@Model.SolicitudMantenimientoMode.IdSolicitud" name="IdSolicitud" id="IdSolicitud" />
                </div>
            </div>
            <!-- Información General -->
            <div class="form-group row">
                <h3 class="col-sm-12">INFORMACION GENERAL</h3>
                <br />
                <div class="col-sm-6">
                    <label>UBICACION</label>

                    <select class="form-control" id="ubicacionSelect" name="IdUbicacion" onchange="cargarEmpleadosPorUbicacion(this.value)">
                        <option value="">Seleccionar Ubicación</option>
                        @foreach (var ubicacion in Model.List_Ubicaciones)
                        {
                            <option value="@ubicacion.IdUbicacion">@ubicacion.Nombre</option>
                        }
                    </select>

                </div>
                <div class="col-sm-6">
                    <label>¿QUIEN REPORTA?</label>
                    <select class="form-control" id="reportaSelect" name="IdEmpleado" required>
                        <option value="">Seleccionar Empleado</option>
                        @foreach (var empleado in Model.List_Empleados)
                        {
                            <option value="@empleado.IdEmpleado">@empleado.Nombre @empleado.ApellidoPaterno</option>
                        }
                    </select>
                </div>

            </div>

            <hr />

            <!-- Información del Servicio -->
            <div class="form-group row">
                <br />
                <h3 class="col-sm-12">INFORMACION DEL SERVICIO</h3>
                <br />

                <div class="col-sm-3">
                    <label>EQUIPO</label>
                    <select class="form-control" id="Equipo" name="IdCategoria" required>

                        <option value="">Seleccionar Equipo</option>
                        @foreach (var maquinaria in Model.List_Categorias)
                        {
                            <option value="@maquinaria.Id_Categoria">@maquinaria.Clasificacion @maquinaria.Nombre_Categoria</option>
                        }
                    </select>
                </div>

                <!-- Grupo 1: Elementos que deben desaparecer si el ID seleccionado es 29 -->
                <div id="Group1">
                    <div class="col-sm-3">
                        <label>No. ECONOMICO</label>
                        <select class="form-control" id="NoEconomico" name="IdMaquinaria" required>
                            <option value="">Seleccionar</option>
                        </select>
                    </div>

                    <div class="col-sm-3">
                        <label>MAQUINARIA</label>
                        <input disabled class="form-control" id="Maquinaria" name="maquinaria" />
                    </div>

                    <div class="col-sm-3">
                        <label>ASIGNADO A:</label>
                        <input type="text" class="form-control" name="asignado" />
                    </div>
                </div>

                <!-- Grupo 2: Elementos que deben aparecer si el ID seleccionado es 29 -->
                <div id="Group2" style="display: none;">
                    <div class="col-sm-3">
                        <label>INSTALACION</label>
                        <select class="form-control" id="Instalacion" name="IdInstalacion" required>
                            <option value="">Seleccionar</option>
                        </select>
                    </div>

                    <div class="col-sm-3">
                        <label>DESCRIPCION</label>
                        <input disabled class="form-control" id="Descripcion" name="descripcion" />
                    </div>
                </div>

                



            </div>

            <div class="form-group row">
                <div class="col-sm-3">
                    <label>FECHA DE SERVICIO</label>
                    <input type="date" class="form-control" name="FechaServicio" required />
                </div>
                <div class="col-sm-3">
                    <label>FECHA DE ENTREGA</label>
                    <input type="date" class="form-control" name="FechaEntrega" required />
                </div>
                <div class="col-sm-3">
                    <label>GRADO DE URGENCIA</label>
                    <input type="text" class="form-control" name="GradoUrgencia" id="GradoUrgencia" readonly />
                </div>
                <div class="col-sm-3">
                    <label>RESPONSABLE DE SEGUIMIENTO</label>
                    <select class="form-control" id="responsableSelect" name="IdResponsable" required>
                        <option value="">Seleccionar Responsable</option>
                        @foreach (var empleado in Model.List_Empleados)
                        {
                            <option value="@empleado.IdEmpleado">@empleado.Nombre @empleado.ApellidoPaterno</option>
                        }
                    </select>
                </div>
            </div>
                <hr />

                <!-- Costo y Proveedor -->
                <div class="form-group row">
                    <br />
                    <h3 class="col-sm-12">COSTO REPARACION Y PROVEEDOR</h3>
                    <br />
                    <div class="col-sm-3">
                        <label>COSTO APROX.</label>
                        <input type="number" class="form-control" name="CostoReparacion" step="0.01" />
                    </div>
                    <div class="col-sm-3">
                        <label>PROVEEDOR ENCARGADO DE LA REPARACION</label>
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="TipoServicio" id="servicioInterno" value="Servicio Interno" checked>
                            <label class="form-check-label" for="servicioInterno">Servicio Interno</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="TipoServicio" id="servicioExterno" value="Servicio Externo">
                            <label class="form-check-label" for="servicioExterno">Servicio Externo</label>
                        </div>
                    </div>


                    <!-- Contenedor para Encargado del Servicio -->
                    <div id="ServicioInterno" class="col-sm-3">
                        <label>ENCARGADO</label>
                        <select class="form-control" id="ProveedorReparacion" name="ProveedorReparacion">
                            <option value="">Seleccionar</option>
                            @foreach (var maquinaria in Model.List_ServicioInterno)
                            {
                                <option value="@maquinaria.Nombre @maquinaria.ApellidoPaterno">@maquinaria.Nombre @maquinaria.ApellidoPaterno</option>
                            }
                        </select>
                    </div>

                    <div id="ServicioExterno" class="col-sm-3" style="display: none;">
                        <label>Encargado de servicio:</label>
                        <input type="text" class="form-control" name="ProveedorReparacion" />
                    </div>

                </div>


                <hr />

                <!-- Descripción del Problema -->
    <div class="form-group row">
        <br />
        <h3 class="col-sm-12">DESCRIPCION DEL PROBLEMA DEL EQUIPO</h3>
        <br />
        <div class="col-sm-12">
            <textarea class="form-control" name="DescripcionProblema" rows="3" required></textarea>
            </div>
        </div>

        <hr />

        <div class="form-group row">
            <h3 class="col-sm-12">EVIDENCIA DEL PROBLEMA REPORTADO</h3>
            <!-- Evidencia 1 -->
            <label class="col-sm-2 col-form-label">SUBIR EVIDENCIA 1</label>
            <div class="col-sm-4">
                <div id="uploadBox1" style="border: 2px dashed #ccc; width: 100%; height: 200px; display: flex; justify-content: center; align-items: center; text-align: center;">
                    <span id="uploadText1">Clic para subir evidencia 1</span>
                    <img id="imagenPreview1" src="#" alt="Vista previa de la imagen 1" style="max-width: 100%; max-height: 100%; display: none;">
                </div>
                <input type="file" id="imagenInput1" name="imagen1" accept="image/*" style="display: none;" onchange="validateFile(event, 1)">
                <button type="button" class="btn btn-danger" id="borrarEvidenciaBtn1" onclick="deleteEvidence(1)" style="display:none;">Borrar Evidencia 1</button>
            </div>

            <!-- Evidencia 2 -->
            <label class="col-sm-2 col-form-label">SUBIR EVIDENCIA 2</label>
            <div class="col-sm-4">
                <div id="uploadBox2" style="border: 2px dashed #ccc; width: 100%; height: 200px; display: flex; justify-content: center; align-items: center; text-align: center;">
                    <span id="uploadText2">Clic para subir evidencia 2</span>
                    <img id="imagenPreview2" src="#" alt="Vista previa de la imagen 2" style="max-width: 100%; max-height: 100%; display: none;">
                </div>
                <input type="file" id="imagenInput2" name="imagen2" accept="image/*" style="display: none;" onchange="validateFile(event, 2)">
                <button type="button" class="btn btn-danger" id="borrarEvidenciaBtn2" onclick="deleteEvidence(2)" style="display:none;">Borrar Evidencia 2</button>
            </div>

            <!-- Evidencia 3 -->
            <label class="col-sm-2 col-form-label">SUBIR EVIDENCIA 3</label>
            <div class="col-sm-4">
                <div id="uploadBox3" style="border: 2px dashed #ccc; width: 100%; height: 200px; display: flex; justify-content: center; align-items: center; text-align: center;">
                    <span id="uploadText3">Clic para subir evidencia 3</span>
                    <img id="imagenPreview3" src="#" alt="Vista previa de la imagen 3" style="max-width: 100%; max-height: 100%; display: none;">
                </div>
                <input type="file" id="imagenInput3" name="imagen3" accept="image/*" style="display: none;" onchange="validateFile(event, 3)">
                <button type="button" class="btn btn-danger" id="borrarEvidenciaBtn3" onclick="deleteEvidence(3)" style="display:none;">Borrar Evidencia 3</button>
            </div>

            <!-- Evidencia 4 -->
            <label class="col-sm-2 col-form-label">SUBIR EVIDENCIA 4</label>
            <div class="col-sm-4">
                <div id="uploadBox4" style="border: 2px dashed #ccc; width: 100%; height: 200px; display: flex; justify-content: center; align-items: center; text-align: center;">
                    <span id="uploadText4">Clic para subir evidencia 4</span>
                    <img id="imagenPreview4" src="#" alt="Vista previa de la imagen 4" style="max-width: 100%; max-height: 100%; display: none;">
                </div>
                <input type="file" id="imagenInput4" name="imagen4" accept="image/*" style="display: none;" onchange="validateFile(event, 4)">
                <button type="button" class="btn btn-danger" id="borrarEvidenciaBtn4" onclick="deleteEvidence(4)" style="display:none;">Borrar Evidencia 4</button>
            </div>

        </div>

        <input type="hidden" id="imagen1Base64" name="Evidencia1" />
        <input type="hidden" id="imagen2Base64" name="Evidencia2" />
        <input type="hidden" id="imagen3Base64" name="Evidencia3" />
        <input type="hidden" id="imagen4Base64" name="Evidencia4" />

        <hr />

        <!-- Botón de Guardar -->
        <div class="form-group text-center">
            <button type="submit" class="btn btn-primary">GUARDAR</button>
        </div>
        }
    </div>
        </div>

<script>
    $(document).ready(function () {
        let maquinariaList = []; // Lista de maquinarias cargadas dinámicamente
        let instalacionList = []; // Lista de instalaciones cargadas dinámicamente

        // Manejo del campo "Proveedor"
        $('input[name="TipoServicio"]').on('change', function () {
            if ($(this).val() === "Servicio Interno") {
                $('#ServicioInterno').show();
                $('#ServicioExterno').hide();
            } else {
                $('#ServicioExterno').show();
                $('#ServicioInterno').hide();
            }
        });

        // Inicialización del estado visible según el valor predeterminado del proveedor
        if ($('input[name="TipoServicio"]:checked').val() === "Servicio Interno") {
            $('#ServicioInterno').show();
            $('#ServicioExterno').hide();
        } else {
            $('#ServicioExterno').show();
            $('#ServicioInterno').hide();
        }

        // Función para calcular el grado de urgencia
        function calcularGradoUrgencia() {
            const fechaServicio = $('input[name="FechaServicio"]').val();
            const fechaEntrega = $('input[name="FechaEntrega"]').val();

            if (fechaServicio && fechaEntrega) {
                const fechaInicio = new Date(fechaServicio);
                const fechaFin = new Date(fechaEntrega);
                const diferenciaDias = (fechaFin - fechaInicio) / (1000 * 60 * 60 * 24);

                let gradoUrgencia = '';
                if (diferenciaDias === 1) {
                    gradoUrgencia = 'URGENTE';
                } else if (diferenciaDias >= 2 && diferenciaDias <= 4) {
                    gradoUrgencia = 'MEDIO';
                } else if (diferenciaDias >= 5) {
                    gradoUrgencia = 'BAJO';
                }

                $('input[name="GradoUrgencia"]').val(gradoUrgencia);
            } else {
                $('input[name="GradoUrgencia"]').val('');
            }
        }

        // Detectar cambios en las fechas
        $('input[name="FechaServicio"], input[name="FechaEntrega"]').on('change', calcularGradoUrgencia);

        // Manejo de cambios en el campo "Equipo"
        $('#Equipo').on('change', function () {
            const selectedId = $(this).val();
            const idUbicacion = $('select[name="IdUbicacion"]').val();

            if (selectedId == "29") {
                $('#Group1').hide();
                $('#Group2').show();
                $('#Instalacion').prop('required', true);
                $('#NoEconomico').prop('required', false);

                if (idUbicacion) {
                    cargarInstalacionesPorUbicacion(idUbicacion);
                } else {
                    alert("Seleccione una ubicación antes de continuar.");
                }
            } else {
                $('#Group1').show();
                $('#Group2').hide();
                $('#NoEconomico').prop('required', true);
                $('#Instalacion').prop('required', false);

                if (idUbicacion) {
                    cargarMaquinarias(idUbicacion, selectedId);
                }
            }
        });

        // Manejo de cambios en "Ubicación"
        $('select[name="IdUbicacion"]').on('change', function () {
            const idUbicacion = $(this).val();
            const idCategoria = $('#Equipo').val();

            if (idCategoria && idCategoria != "29") {
                cargarMaquinarias(idUbicacion, idCategoria);
            } else if (idCategoria == "29") {
                cargarInstalacionesPorUbicacion(idUbicacion);
            }
        });

        // Manejo de cambios en "Instalacion"
        $('#Instalacion').on('change', function () {
            const selectedId = $(this).val();
            if (selectedId) {
                const instalacion = instalacionList.find(i => i.IdInstalacion == selectedId);

                if (instalacion) {
                    $('#Descripcion').val(instalacion.Descripcion);
                } else {
                    obtenerDescripcionInstalacion(selectedId);
                }
            } else {
                $('#Descripcion').val('');
            }
        });

        // Manejo de cambios en "No. Económico"
        $('#NoEconomico').on('change', function () {
            const idMaquinaria = $(this).val();
            if (idMaquinaria) {
                const maquinaria = maquinariaList.find(m => m.IdMaquinaria == idMaquinaria);

                if (maquinaria) {
                    $('#Maquinaria').val(maquinaria.Marca + ' ' + maquinaria.Modelo);
                } else {
                    alert("Maquinaria no encontrada.");
                    $('#Maquinaria').val('');
                }
            } else {
                $('#Maquinaria').val('');
            }
        });

        // Función para cargar instalaciones
        function cargarInstalacionesPorUbicacion(idUbicacion) {
            $.ajax({
                url: '@Url.Action("ObtenerInstalacionesPorUbicacion", "Solicitud_Mantenimiento")',
                type: 'POST',
                data: { idUbicacion: idUbicacion },
                success: function (response) {
                    if (response.success) {
                        instalacionList = response.data;
                        const instalacionSelect = $('#Instalacion');
                        instalacionSelect.empty();
                        instalacionSelect.append('<option value="">Seleccionar</option>');

                        $.each(instalacionList, function (index, item) {
                            instalacionSelect.append('<option value="' + item.IdInstalacion + '">' + item.Nombre + '</option>');
                        });
                    } else {
                        alert(response.message || "No se encontraron instalaciones para la ubicación seleccionada.");
                    }
                },
                error: function () {
                    alert("Error al comunicarse con el servidor.");
                }
            });
        }

        // Función para cargar maquinarias
        function cargarMaquinarias(idUbicacion, idCategoria) {
            $.ajax({
                url: '@Url.Action("ObtenerMaquinariaPorUbicacionYCategoria", "Solicitud_Mantenimiento")',
                type: 'POST',
                data: { idUbicacion: idUbicacion, idCategoria: idCategoria },
                success: function (response) {
                    if (response.success) {
                        maquinariaList = response.data;
                        const noEconomicoSelect = $('#NoEconomico');
                        noEconomicoSelect.empty();
                        noEconomicoSelect.append('<option value="">Seleccionar Equipo</option>');

                        $.each(maquinariaList, function (index, item) {
                            noEconomicoSelect.append('<option value="' + item.IdMaquinaria + '">' + item.NoEconomico + '</option>');
                        });
                    } else {
                        alert(response.message || "No se encontraron datos.");
                    }
                },
                error: function () {
                    alert("Error al comunicarse con el servidor.");
                }
            });
        }

        // Función para obtener descripción de una instalación
        function obtenerDescripcionInstalacion(idInstalacion) {
            $.ajax({
                url: '@Url.Action("ObtenerDescripcionInstalacion", "Solicitud_Mantenimiento")',
                type: 'POST',
                data: { idInstalacion: idInstalacion },
                success: function (response) {
                    if (response.success) {
                        $('#Descripcion').val(response.descripcion);
                    } else {
                        alert(response.message || "No se encontró la descripción para la instalación seleccionada.");
                        $('#Descripcion').val('');
                    }
                },
                error: function () {
                    alert("Error al comunicarse con el servidor.");
                    $('#Descripcion').val('');
                }
            });
        }

        // Inicializar visibilidad de los grupos según el valor inicial del combo "Equipo"
        const initialSelectedId = $('#Equipo').val();
        if (initialSelectedId == "29") {
            $('#Group1').hide();
            $('#Group2').show();
        } else {
            $('#Group1').show();
            $('#Group2').hide();
        }
    });

    

    function validateFile(event, number) {
        const file = event.target.files[0];

        // Verificar el tipo de archivo
        const allowedTypes = ["image/png", "image/jpeg"];
        if (!allowedTypes.includes(file.type)) {
            alert("Solo se permiten archivos PNG y JPEG.");
            event.target.value = ""; // Limpiar el campo
            return;
        }

        // Verificar el tamaño del archivo (máximo 2 MB)
        const maxSize = 12 * 1024 * 1024; // 2 MB
        if (file.size > maxSize) {
            alert("El archivo es demasiado grande. El tamaño máximo permitido es 2 MB.");
            event.target.value = ""; // Limpiar el campo
            return;
        }

        // Si el archivo es válido, convertirlo a Base64 (u otro procesamiento)
        convertImageToBase64(event, number);
    }
    // Convertir imagen a Base64 y actualizar vista previa
    function convertImageToBase64(event, number) {
        var reader = new FileReader();
        reader.onload = function () {
            var output = document.getElementById('imagenPreview' + number);
            var text = document.getElementById('uploadText' + number);
            var base64Field = document.getElementById('imagen' + number + 'Base64');
            var deleteBtn = document.getElementById('borrarEvidenciaBtn' + number);

            output.src = reader.result;
            output.style.display = 'block';
            text.style.display = 'none';
            base64Field.value = reader.result; // Guardar en el campo oculto
            deleteBtn.style.display = "inline-block"; // Mostrar botón para eliminar
        };
        reader.readAsDataURL(event.target.files[0]);
    }

    

    // Función para comprimir la imagen
    function compressImage(file, maxWidth, maxHeight, quality, callback) {
        const reader = new FileReader();
        reader.onload = function (event) {
            const img = new Image();
            img.onload = function () {
                const canvas = document.createElement("canvas");
                const ctx = canvas.getContext("2d");

                // Calcular dimensiones
                let width = img.width;
                let height = img.height;

                if (width > height) {
                    if (width > maxWidth) {
                        height = Math.round((height * maxWidth) / width);
                        width = maxWidth;
                    }
                } else {
                    if (height > maxHeight) {
                        width = Math.round((width * maxHeight) / height);
                        height = maxHeight;
                    }
                }

                canvas.width = width;
                canvas.height = height;

                // Dibujar la imagen en el canvas
                ctx.drawImage(img, 0, 0, width, height);

                // Convertir canvas a Blob
                canvas.toBlob(
                    function (blob) {
                        callback(blob);
                    },
                    file.type,
                    quality // Calidad de compresión (0.1 - 1)
                );
            };
            img.src = event.target.result;
        };
        reader.readAsDataURL(file);
    }

    // Función para eliminar la evidencia y reiniciar la vista previa
    function deleteEvidence(number) {
        var output = document.getElementById('imagenPreview' + number);
        var text = document.getElementById('uploadText' + number);
        var base64Field = document.getElementById('imagen' + number + 'Base64');
        var deleteBtn = document.getElementById('borrarEvidenciaBtn' + number);

        output.src = "#";
        output.style.display = 'none';
        text.style.display = 'inline-block';
        base64Field.value = ""; // Limpiar el campo oculto
        deleteBtn.style.display = "none"; // Ocultar botón de borrar
    }


    // Asignar eventos a los cuadros de subida
    document.getElementById("uploadBox1").addEventListener("click", function () {
        document.getElementById("imagenInput1").click();
    });
    document.getElementById("uploadBox2").addEventListener("click", function () {
        document.getElementById("imagenInput2").click();
    });
    document.getElementById("uploadBox3").addEventListener("click", function () {
        document.getElementById("imagenInput3").click();
    });
    document.getElementById("uploadBox4").addEventListener("click", function () {
        document.getElementById("imagenInput4").click();
    });

   

    function cargarEmpleadosPorUbicacion(idUbicacion) {
    if (!idUbicacion) {
        // Si no hay ubicación seleccionada, reinicia los combos
        $('#reportaSelect, #responsableSelect').empty().append('<option value="">Seleccionar Empleado</option>');
        return;
    }

    $.ajax({
        url: '@Url.Action("GetEmpleadosByUbicacion", "Solicitud_Mantenimiento")',
        type: 'GET',
        data: { idUbicacion: idUbicacion },
        success: function (response) {
            if (response.success) {
                // Actualiza ambos combos
                var empleadosOptions = '<option value="">Seleccionar Empleado</option>';
                response.empleados.forEach(function (empleado) {
                    empleadosOptions += `<option value="${empleado.IdEmpleado}">${empleado.Nombre}</option>`;
                });

                $('#reportaSelect').html(empleadosOptions);
                $('#responsableSelect').html(empleadosOptions);
            } else {
                alert('Error al cargar empleados: ' + response.message);
            }
        },
        error: function (xhr, status, error) {
            console.error("Error al cargar empleados:", error);
            alert('Ocurrió un error al cargar los empleados.');
        }
    });

        
   }

    // Validación en la función de envío del formulario
    $('form').on('submit', function (e) {
        // Cambiar solo la validación visual, no detendremos el envío si faltan evidencias
        for (var i = 1; i <= 4; i++) {
            if (!$('#imagen' + i + 'Base64').val()) {
                $('#uploadBox' + i).css('border', '2px dashed #ccc'); // Borde predeterminado
            } else {
                $('#uploadBox' + i).css('border', '2px dashed #ccc'); // Borde válido
            }
        }
    });




</script>
